{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scene_id", "source", "table", "objects", "scale_reference", "notes", "questions", "confirmed"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["image", "sha256"], "properties": {"image": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "confirmed": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}, "maxItems": 50},
    "questions": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
    "scale_reference": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["object_id", "axis", "length_m"], "properties": {"object_id": {"$ref": "#/$defs/id"}, "axis": {"enum": [0, 1, 2]}, "length_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}}}]},
    "table": {"type": "object", "additionalProperties": false, "required": ["dimensions", "top_z", "rgba", "friction", "provenance"], "properties": {
      "dimensions": {"$ref": "#/$defs/dimensions"}, "top_z": {"type": "number", "minimum": 0.05, "maximum": 1.5},
      "rgba": {"$ref": "#/$defs/rgba"}, "friction": {"$ref": "#/$defs/friction"},
      "provenance": {"type": "object", "additionalProperties": false, "required": ["dimensions", "top_z", "rgba", "friction"], "properties": {"dimensions": {"$ref": "#/$defs/origin"}, "top_z": {"$ref": "#/$defs/origin"}, "rgba": {"$ref": "#/$defs/origin"}, "friction": {"$ref": "#/$defs/origin"}}}
    }},
    "objects": {"type": "array", "minItems": 1, "maxItems": 5, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "dimensions", "xy", "quaternion", "rgba", "mass", "friction", "support", "image_bbox", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "category": {"enum": ["box", "cylinder", "sphere", "pen", "eraser", "book"]},
        "dimensions": {"$ref": "#/$defs/dimensions"}, "xy": {"type": "array", "items": {"type": "number", "minimum": -2, "maximum": 2}, "minItems": 2, "maxItems": 2},
        "quaternion": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1}, "minItems": 4, "maxItems": 4},
        "rgba": {"$ref": "#/$defs/rgba"}, "mass": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}, "friction": {"$ref": "#/$defs/friction"},
        "support": {"const": "table"}, "image_bbox": {"$ref": "#/$defs/rgba"},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["category", "dimensions", "xy", "quaternion", "rgba", "mass", "friction"], "properties": {"category": {"$ref": "#/$defs/origin"}, "dimensions": {"$ref": "#/$defs/origin"}, "xy": {"$ref": "#/$defs/origin"}, "quaternion": {"$ref": "#/$defs/origin"}, "rgba": {"$ref": "#/$defs/origin"}, "mass": {"$ref": "#/$defs/origin"}, "friction": {"$ref": "#/$defs/origin"}}}
      }
    }}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
    "origin": {"enum": ["image_estimate", "catalog_default", "user_input"]},
    "dimensions": {"type": "array", "items": {"type": "number", "minimum": 0.002, "maximum": 3}, "minItems": 3, "maxItems": 3},
    "rgba": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 4, "maxItems": 4},
    "friction": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 5}, "minItems": 3, "maxItems": 3}
  }
}
